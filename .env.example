# ---------------------------------------------------------------------------
# Bulgaria Auto CarMarket — example configuration
# Copy to .env and change every secret before exposing the app.
# ---------------------------------------------------------------------------

APP_ENV=production
LOG_LEVEL=INFO
ADMIN_API_KEY=change-me-use-a-long-random-value
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

BACKEND_PORT=8000
FRONTEND_PORT=8080

POSTGRES_USER=carmarket
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=carmarket
DATABASE_URL=postgresql+psycopg://carmarket:change-me-postgres-password@postgres:5432/carmarket

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ROOT_USER=carmarket-minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=carmarket-minio
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=carmarket
S3_SECURE=false

SCRAPE_USER_AGENT=BulgariaAutoCarMarket/1.0 (self-hosted; respectful crawler; contact: admin@example.invalid)
REQUEST_TIMEOUT_SECONDS=30
SCRAPER_RETRY_LIMIT=3
SCRAPER_BACKOFF_SECONDS=2
IMAGE_DOWNLOAD_ENABLED=false
IMAGE_MAX_BYTES=8000000
IMAGE_MAX_PER_LISTING=10
ARCHIVE_ENABLED=false
ARCHIVE_MAX_BYTES=8000000
STALE_LISTING_DAYS=14

# AI is optional. Keep it disabled unless you start the "ai" profile.
AI_ENABLED=false
AI_AUTO_ANALYZE=false
AI_ANALYZE_IMAGES=false
AI_INCLUDE_DESCRIPTIONS=true
AI_DEFAULT_TASK=best_deals
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
AI_MAX_CONCURRENCY=1
AI_TIMEOUT_SECONDS=180
AI_MAX_ATTEMPTS=3
AI_CANDIDATE_LIMIT=40

# Optional NVIDIA GPU support. Leave empty for CPU.
# OLLAMA_GPU_DRIVER=nvidia
